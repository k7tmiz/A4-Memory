{
  "name": "a4-memory",
  "private": true,
  "version": "3.1.1",
  "description": "A4 纸随机排版背单词",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "check": "npm run check:version && npm run check:cache && npm run lint && npm test",
    "check:version": "node scripts/check-version.mjs",
    "bump-version": "node scripts/bump-version.mjs",
    "cache-bust": "node scripts/cache-bust.mjs",
    "check:cache": "node scripts/cache-bust.mjs --check",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.e2e.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "eslint": "^10.3.0",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  }
}
